# Cloudflare Tunnel config — EXAMPLE ONLY. Placeholders, no secrets.
# Copy to config.yml, fill in your own tunnel id and hostname, and
# keep config.yml OUT of git (it names your tunnel).
tunnel: TUNNEL-ID-PLACEHOLDER
credentials-file: /home/jetson/.cloudflared/TUNNEL-ID-PLACEHOLDER.json

ingress:
  # The kiosk app + backend, served by agent-backend on port 8000.
  # The backend mounts the repo's static files, so one origin serves
  # both the UI and /api/*. Ollama on 11434 is NEVER an ingress rule.
  - hostname: kiosk-PLACEHOLDER.example.com
    service: http://localhost:8000
  # Catch-all: anything else gets a 404, not the kiosk.
  - service: http_status:404
